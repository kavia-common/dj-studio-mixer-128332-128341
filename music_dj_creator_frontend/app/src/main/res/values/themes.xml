<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DJStudio.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/surfaceLight</item>
        <item name="materialButtonStyle">@style/Widget.DJStudio.Button</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Widget.DJStudio.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
